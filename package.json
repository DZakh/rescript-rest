    "ava": "5.3.1",
    "c8": "10.1.2",
    "fastify": "5.1.0",
    "rescript": "12.2.0",
    "sury": "11.1.0-rc.0",
    "swr": "2.3.2"
  },
  "peerDependencies": {
    "@fastify/swagger": "9.x",
    "@scalar/fastify-api-reference": "^1.25.60",
    "fastify": "5.x",
    "swr": "^2.3.2",
